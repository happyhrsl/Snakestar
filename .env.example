# ═══════════════════════════════════════════════════════════════
# Snakestar — Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════

# Database (SQLite file path — must be absolute or relative to project root)
DATABASE_URL=file:./db/custom.db

# JWT secret for session tokens (generate a random 32+ char string)
JWT_SECRET=change-me-to-a-random-secret-in-production

# Optional: Social OAuth (Google, Facebook, Apple) — coming soon
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=
